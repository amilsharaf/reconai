# ==========================================
# ReconAI — Environment Variables
# ==========================================

NODE_ENV=development

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Found in Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------
# Database Direct / Pooler Connection String
# ------------------------------------------
# Found in Supabase: Project Settings -> Database -> Connection String
# Used by scripts/load_synthetic_data.py and database migrations.
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------
# AI Layer
# ------------------------------------------
# Claude API key — used only for explaining exceptions, never for arithmetic.
ANTHROPIC_API_KEY=sk-ant-...
