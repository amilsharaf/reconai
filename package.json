{
  "name": "reconai",
  "version": "0.1.0",
  "private": true,
  "description": "ReconAI - AI-assisted multi-source financial reconciliation (Razorpay Internship, Track 04)",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@reconai/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "generate:data": "python scripts/generate_synthetic_data.py",
    "load:data": "python scripts/load_synthetic_data.py",
    "migrate:db": "python scripts/apply_migrations.py",
    "reconcile": "npm run reconcile --workspace=@reconai/web",
    "evaluate": "python scripts/evaluate.py"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
